{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sinkspace.com.au/schemas/sink-task-v0.json",
  "title":"Sink Clone Task",
  "type":"object",
  "additionalProperties":false,
  "required":["taskId","objective","assignedTo","acceptanceCriteria","risk","status"],
  "properties":{
    "taskId":{"type":"string","minLength":1},
    "parentTaskId":{"type":["string","null"]},
    "objective":{"type":"string","minLength":1},
    "assignedTo":{"enum":["SINK-00","SINK-01","SINK-02","SINK-03","SINK-04"]},
    "inputs":{"type":"array","items":{"type":"string"},"default":[]},
    "acceptanceCriteria":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "risk":{"enum":["low","medium","high"]},
    "humanApprovalRequired":{"type":"boolean","default":false},
    "status":{"enum":["queued","running","blocked","awaiting_verification","passed","failed"]}
  }
}
